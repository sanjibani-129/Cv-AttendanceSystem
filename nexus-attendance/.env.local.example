# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used only by server-side API routes (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Distance under which two face descriptors are considered a match (0.0-1.0, lower = stricter)
NEXT_PUBLIC_FACE_MATCH_THRESHOLD=0.5
